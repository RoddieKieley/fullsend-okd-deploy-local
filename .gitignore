# Build artifacts and vendored inputs: reproduced by rebuild-runner.sh from the
# agents worktree and the built fullsend binary. Never commit them.
image/fullsend
image/openshell
image/agents-okd/

# Never commit credentials or local environment files.
**/vertex-credentials.json
**/*.pem
**/*.key
**/*.env
**/hosts.yml
**/ghconfig/

# Scratch output.
/tmp/

# Per-cluster values (identifiers, LAN hosts) — never commit.
values.local.env
*.local.env
k8s/rendered/
k8s/projects-config.yaml
opencode-config.json
